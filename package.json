{
  "name": "@susisu/oxlint-config",
  "version": "0.0.0",
  "description": "my oxlint config",
  "license": "MIT",
  "author": "Susisu <susisu2413@yahoo.co.jp>",
  "repository": "https://github.com/susisu/oxlint-config.git",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:rule-table": "node scripts/generate-rule-table.ts",
    "generate:rule-table:check": "node scripts/generate-rule-table.ts --check",
    "test": "vitest run",
    "test:dev": "vitest dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
