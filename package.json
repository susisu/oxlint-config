{
  "name": "@susisu/oxlint-config",
  "version": "0.0.0",
  "description": "my oxlint config",
  "license": "MIT",
  "author": "Susisu <susisu2413@yahoo.co.jp>",
  "repository": "https://github.com/susisu/oxlint-config.git",
  "files": [
    "lib",
    "src",
    "!src/**/*.{test,spec}.{ts,tsx}",
    "!src/**/__tests__"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:rule-table": "node scripts/generate-rule-table.ts",
    "generate:rule-table:check": "node scripts/generate-rule-table.ts --check",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0",
    "oxlint-tsgolint": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
